{
  "name": "facilitador-bsv-x402-accesible",
  "version": "1.0.0",
  "description": "Facilitador X402 para Bitcoin SV con accesibilidad universal",
  "main": "src/facilitator/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:resource": "wrangler dev --config src/resource-server/wrangler.toml",
    "example:client": "npx tsx src/resource-server/example-client.ts",
    "build": "tsc && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "deploy:resource": "wrangler deploy --config src/resource-server/wrangler.toml --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:resource": "bash scripts/test-resource-server.sh",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "x402",
    "bitcoin-sv",
    "bsv",
    "payment",
    "facilitator",
    "accessibility",
    "cloudflare-workers"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@bsv/sdk": "^1.9.11",
    "@hono/zod-validator": "^0.4.0",
    "hono": "^4.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.51.0",
    "xml2js": "^0.6.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
